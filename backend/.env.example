# Copy to backend/.env and adjust. Never commit the real .env.

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Public URL of this API as seen by the browser (used by /api/bootstrap.js).
# The website reads its own copy from frontend/assets/js/api-config.js.
PUBLIC_API_BASE=https://api.example.com

# Browser origins allowed to call the API (comma separated).
# Required when the static site is on another host, for example:
#   https://YOUR-USER.github.io,https://www.example.com
# GitHub Pages project sites send the origin only (https://YOUR-USER.github.io).
ALLOWED_ORIGINS=

# Optional key for /api/calculate. Leave empty for the public website: a static
# page cannot hold a secret. It does NOT make the analytics dashboards public;
# use ANALYTICS_KEY (or ANALYTICS_PUBLIC) for those.
API_KEY=

# Rate limiting for /api (requests per window, per client IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Largest accepted JSON body, in bytes
MAX_BODY_BYTES=16384

# Analytics (first-party calculator views, clicks and Row advertisement events).
# Events are appended to one NDJSON file per UTC day in ANALYTICS_DATA_DIR.
ANALYTICS_ENABLED=true

# Key required by the dashboard reports and share-link management, sent as
# x-api-key (or ?key=). Falls back to API_KEY when empty. With no key at all the
# reports refuse to serve (503 analytics_locked) instead of exposing the site's
# analytics to anyone: this is deliberate fail-closed behaviour.
ANALYTICS_KEY=
# Set to true only to publish the dashboards on a server with no analytics key.
ANALYTICS_PUBLIC=false
# ANALYTICS_DATA_DIR=/var/lib/mw-analytics
ANALYTICS_RETENTION_DAYS=400
ANALYTICS_MAX_EVENTS=200000
# Views and impressions are counted at most once per device in this window.
ANALYTICS_DEDUPE_WINDOW_MS=1800000
# Share links are stored as shares.json next to ANALYTICS_DATA_DIR.
# Their expiry is checked against the server clock on every request.
